#!/usr/bin/env bash
# pre-push: runs on every `git push`. Blocks the push on any failure.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

fail() { echo "❌ $*" >&2; exit 1; }
step() { echo "▶ $*"; }

step "client-typescript: lint"
pnpm lint || fail "lint failed"

step "client-typescript: type check"
pnpm type-check || fail "type check failed"

step "client-typescript: tests"
pnpm test || fail "tests failed"

step "client-typescript: build"
pnpm build || fail "build failed"

echo "✅ pre-push checks passed"
